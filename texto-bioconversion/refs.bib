  title = {Comparison of the {{Characteristics}} of {{Small Commercial NDIR CO2 Sensor Models}} and {{Development}} of a {{Portable CO2 Measurement Device}}},
  author = {Yasuda, Tomomi and Yonemura, Seiichiro and Tani, Akira},
