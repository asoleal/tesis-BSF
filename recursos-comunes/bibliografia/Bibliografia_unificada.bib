@article{soontronprasatpornApplyingInternetThings2024,
  title = {Applying the Internet of Things ({{IoT}}) for Raising Black Soldier {{Fly}} ({{BSF}}) in Closed System to Minimize Greenhouse Gas Emissions},
  author = {Soontronprasatporn, Kitiphan and Arunrungrusmi, Somchai and Tunlasakun, Khanchai and Mungkung, Narong and Tamrongkunannun, Tanapon},
  year = 2024,
