@article{pangReducingGreenhouseGas2020,
  title = {Reducing Greenhouse Gas Emissions and Enhancing Carbon and Nitrogen Conversion in Food Wastes by the Black Soldier Fly},
  author = {Pang, Wancheng and Hou, Dejia and Chen, Jiangshan and Nowar, Elhosseny E. and Li, Zongtian and Hu, Ronggui and Tomberlin, Jeffery K. and Yu, Ziniu and Li, Qing and Wang, Shucai},
  year = 2020,
  month = apr,
  journal = {Journal of Environmental Management},
  volume = {260},
  pages = {110066},
