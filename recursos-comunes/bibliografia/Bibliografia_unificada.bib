@article{siddiquiEnhancingBioconversionRate2024,
  title = {Enhancing the Bioconversion Rate and End Products of Black Soldier Fly ({{BSF}}) Treatment -- {{A}} Comprehensive Review},
  author = {Siddiqui, Shahida Anusha and S{\"u}fer, {\"O}zge and {\c C}al{\i}{\c s}kan Ko{\c c}, G{\"u}l{\c s}ah and Lutuf, Hanif and Rahayu, Teguh and {Castro-Mu{\~n}oz}, Roberto and Fernando, Ito},
