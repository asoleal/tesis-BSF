@article{meneguzEffectRearingSubstrate2018,
  title = {Effect of Rearing Substrate on Growth Performance, Waste Reduction Efficiency and Chemical Composition of Black Soldier Fly ( {\textsc{ }}{{{\textsc{{\emph{Hermetia}}}}}}{\textsc{{\emph{ Illucens}}}}{\textsc{ }} ) Larvae},
  shorttitle = {Effect of Rearing Substrate on Growth Performance, Waste Reduction Efficiency and Chemical Composition of Black Soldier Fly (},
  author = {Meneguz, Marco and Schiavone, Achille and Gai, Francesco and Dama, Andrea and Lussiana, Carola and Renna, Manuela and Gasco, Laura},
  year = 2018,
  month = dec,
  journal = {Journal of the Science of Food and Agriculture},
